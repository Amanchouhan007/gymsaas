# ==============================================================================
# GYM MANAGEMENT SAAS — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

PORT=4000
NODE_ENV=development

# ── 1. Application & Domain URLs ──
BACKEND_URL="https://api.gym-newss.kiaantechnology.com"
FRONTEND_URL="https://gym-newss.kiaantechnology.com"

# ── 2. Database Configuration ──
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=gymsaas_db
DB_PORT=3306
DATABASE_URL="mysql://root:@localhost:3306/gymsaas_db"

# ── 3. Google Play Billing & Service Account Configuration ──
GOOGLE_APPLICATION_CREDENTIALS="./src/config/google-service-account.json"
GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./src/config/google-service-account.json"
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH="./src/config/google-service-account.json"
GOOGLE_PLAY_PACKAGE_NAME="com.gymsaas.app"
GOOGLE_PLAY_PROJECT_ID="gym-saas-production"
GOOGLE_PLAY_WEBHOOK_SECRET="your_webhook_secret_here"
GOOGLE_PUBSUB_VERIFICATION_TOKEN="your_webhook_secret_here"
GOOGLE_PUBSUB_WEBHOOK_SECRET="your_webhook_secret_here"
GOOGLE_PLAY_PUBSUB_AUDIENCE="https://api.gym-newss.kiaantechnology.com/api/purchases/google-play/webhook"
GOOGLE_PUBSUB_AUDIENCE="https://api.gym-newss.kiaantechnology.com/api/purchases/google-play/webhook"
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT="play-billing-service@gym-saas.iam.gserviceaccount.com"
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL="play-billing-service@gym-saas.iam.gserviceaccount.com"
GOOGLE_PLAY_TEST_MODE=false
GOOGLE_PLAY_MOCK_MODE=false

# ── 4. Security & Authentication ──
ENCRYPTION_KEY="gym_management_secret_key_32bytes"
JWT_SECRET="changeme"

# ── 5. Email & Notification Service (Brevo) ──
MAIL_FROM_NAME="Kiaan Technology Pvt Ltd"
MAIL_FROM_EMAIL="info@kiaantechnology.com"
MAIL_FROM="Kiaan Technology Pvt Ltd <info@kiaantechnology.com>"
BREVO_API_KEY=""

# ── 6. Cloudinary Media Storage ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── 7. Web Payment Gateway (Razorpay) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
