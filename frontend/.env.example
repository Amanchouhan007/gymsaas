# ==============================================================================
# GYM MANAGEMENT SAAS — FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# ── 1. API & Backend URLs ──
VITE_API_URL=https://api.gym-newss.kiaantechnology.com/api/
VITE_BACKEND_URL=https://api.gym-newss.kiaantechnology.com
VITE_FRONTEND_URL=https://gym-newss.kiaantechnology.com

# ── 2. Google Play Billing & Service Account Configuration ──
GOOGLE_APPLICATION_CREDENTIALS="./src/config/google-service-account.json"
GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./src/config/google-service-account.json"
GOOGLE_PLAY_PACKAGE_NAME="com.gymsaas.app"
GOOGLE_PLAY_PROJECT_ID="gym-saas-production"
GOOGLE_PLAY_WEBHOOK_SECRET="your_webhook_secret_here"
GOOGLE_PUBSUB_VERIFICATION_TOKEN="your_webhook_secret_here"
GOOGLE_PLAY_PUBSUB_AUDIENCE="https://api.gym-newss.kiaantechnology.com/api/purchases/google-play/webhook"
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT="play-billing-service@gym-saas.iam.gserviceaccount.com"
GOOGLE_PLAY_TEST_MODE=false
GOOGLE_PLAY_MOCK_MODE=false

# ── 3. Google Play Store & Android Package Configuration (Vite Client) ──
VITE_PACKAGE_NAME=com.gymsaas.app
VITE_APP_NAME="Gym Management"
VITE_GOOGLE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.gymsaas.app
VITE_GOOGLE_PLAY_SUBSCRIPTIONS_URL=https://play.google.com/store/account/subscriptions

# ── 4. Google Play In-App Billing Subscription Tiers ──
VITE_PLAY_BILLING_STARTER_PRODUCT_ID=gym_starter
VITE_PLAY_BILLING_STANDARD_PRODUCT_ID=gym_standard
VITE_PLAY_BILLING_PRO_PRODUCT_ID=gym_pro

# ── 5. APK Direct Distribution Link ──
VITE_ANDROID_APK_URL=/GymSaaS.apk
VITE_ANDROID_APK_VERSION=1.0.1

# ── 6. Google Play Compliance & Legal Endpoints ──
VITE_ACCOUNT_DELETION_URL=https://gym-newss.kiaantechnology.com/delete-account
VITE_PRIVACY_POLICY_URL=https://gym-newss.kiaantechnology.com/privacy-policy
VITE_TERMS_URL=https://gym-newss.kiaantechnology.com/terms-of-service
VITE_SUPPORT_EMAIL=info@kiaantechnology.com

# ── 7. Web Payment Gateway Configuration (Razorpay) ──
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_here"
